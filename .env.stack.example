# Template for a NEW tenant stack (no issuer recovery).
# Post-deploy copies this into .env after filling Secrets Manager values.
# Do NOT set ISSUER_PORTABLE_DID_CID on first boot â€” a new issuer DID is created.

NODE_ENV=production

CORS_ORIGIN=https://REPLACE_PORTAL_ORIGIN
CORS_METHODS=GET,POST,PUT,DELETE
CORS_PREFLIGHT=true
CORS_OPT_SUCCESS_STATUS=204
CORS_MAX_AGE=60

RL_TTL=60
RL_LIMIT=10

SSI_PROJECT_NAME=TBD
GATEWAY_URI=https://REPLACE_DHT_GATEWAY/

DB_HOST=database
DB_USER=user
DB_PASSWORD=REPLACE_FROM_SECRETS
DB_NAME=iovf-identity

MAILER_TRANSPORT_HOST=smtp.gmail.com
MAIL_USER=REPLACE_MAIL_USER
MAIL_PASSWORD=REPLACE_MAIL_PASSWORD
MAIL_ADDRESS=REPLACE_ISSUER_ADMIN_EMAIL

# Automated first-time issuer init (password never committed; from Secrets Manager)
SECRET_PWD=REPLACE_FROM_SECRETS
# Leave unset for new tenants:
# ISSUER_PORTABLE_DID_CID=
# SALT_ISSUER_DID=
# SALT_ISSUER_CREDENTIALS=

CACHE_TTL=360000

PINATA_JWT_TOKEN=REPLACE_FROM_SECRETS
PINATA_GATEWAY=https://gateway.pinata.cloud

WEB3_ENABLED=false
# WEB3_RPC_URL=
# WEB3_CHAIN_ID=31
# WEB3_CONTRACT_ADDRESS=
# WEB3_PRIVATE_KEY=REPLACE_FROM_SECRETS
# WEB3_CONFIRMATIONS=1

# DID auth / signed documents (A+B) / verifier session — post-deploy fills from Secrets Manager
DID_AUTH_JWT_SECRET=REPLACE_FROM_SECRETS
DOCUMENT_URL_SIGNING_SECRET=REPLACE_FROM_SECRETS
PUBLIC_API_BASE_URL=https://REPLACE_API_HOSTNAME
DID_AUTH_JWT_TTL_SEC=1800
DOCUMENT_URL_TTL_SEC=600
DID_AUTH_REQUIRED=true
VERIFIER_SESSION_JWT_SECRET=REPLACE_FROM_SECRETS
VERIFIER_SESSION_TTL_SEC=43200

